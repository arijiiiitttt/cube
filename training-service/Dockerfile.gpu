FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip build-essential libpq-dev git && \
    rm -rf /var/lib/apt/lists/* && ln -s /usr/bin/python3 /usr/bin/python

COPY requirements.txt .

# torch first, matched to the CUDA 12.1 wheel index
RUN pip install --no-cache-dir torch==2.4.1 --index-url https://download.pytorch.org/whl/cu121
RUN pip install --no-cache-dir -r requirements.txt

# Flash Attention 2 — needs the matching torch build above; falls back to
# SDPA in code if this layer fails on a given image (kept non-fatal on purpose).
RUN pip install --no-cache-dir flash-attn==2.6.3 --no-build-isolation || \
    echo "flash-attn build failed — training will fall back to SDPA attention"

# Optional: Unsloth fast kernels (only used when TrainingConfig.use_unsloth=true)
RUN pip install --no-cache-dir "unsloth[cu121-torch240] @ git+https://github.com/unslothai/unsloth.git" || \
    echo "unsloth install failed — use_unsloth will fall back to standard HF+PEFT path"

COPY . .
CMD ["celery", "-A", "tasks.celery_tasks", "worker", "--loglevel=info", "--concurrency=1"]
