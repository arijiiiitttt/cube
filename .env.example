# ─── App ───────────────────────────────────────────
# Frontend (Vite) reads VITE_API_URL at build time.
# Browser still talks to localhost:8000 by default.
VITE_API_URL=http://localhost:8000

# ─── NeonDB ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/cube?sslmode=require

# ─── Redis ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ─────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=cube-models
MINIO_SECURE=false

# ─── MLflow ────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ─── Training ──────────────────────────────────────
MAX_TRAINING_JOBS=2
